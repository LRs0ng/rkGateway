      "id": "mqtt",
      "type": "mqtt",
      "library": "./libgateway_mqtt_event_publisher.so",
      "enabled": true,
      "config": {
        "host": "127.0.0.1",
        "port": 1883,
        "keepalive": 30,
        "client_id": "rk-gateway-adc-pico",
