{
  "runtime": {
    "run_duration_ms": null,
    "raw_queue_capacity": 32,
    "control_queue_capacity": 32
  },
  "devices": [
    {
      "id": "camera-1",
      "driver": "camera",
      "library": "./libgateway_camera.so",
      "driver_config": {
        "device": "/dev/video0",
        "sensor_mode_width": 3864,
        "sensor_mode_height": 2192,
        "sensor_active_width": 3840,
        "sensor_active_height": 2160,
        "crop_width": 1080,
        "crop_height": 1080,
        "width": 640,
        "height": 640,
        "pixfmt": "nv12",
        "rga_rgb24": true,
        "mode": "periodic",
        "interval_ms": 10000,
        "warmup_frames": 3,
        "capture_timeout_ms": 3000,
        "snapshot_policy": "latest",
        "snapshot_wait_ms": 1000,
        "max_frame_age_ms": 500
      },
      "connection": {},
      "points": [
        {
          "name": "image",
          "type": "bytes",
          "unit": "",
          "address": {},
          "scale": 1.0,
          "offset": 0.0
        }
      ]
    }
  ],
  "groups": [],
  "processors": [],
  "event_publishers": [
    {
      "id": "screen",
      "type": "screen",
      "library": "./libgateway_screen.so",
      "enabled": true,
      "config": {
        "device": "/dev/fb0",
        "panel_controller": "hx8399-c",
        "touch_controller": "gt911",
        "pixel_format": "rgb888",
        "expected_width": 1080,
        "expected_height": 1920,
        "image_point": "image",
        "image_format": "rgb24",
        "image_width": 640,
        "image_height": 640,
        "fit_image": true,
        "numeric_scale": 1,
        "numeric_x": 0,
        "numeric_y": 0,
        "numeric_foreground": "0xffffff",
        "numeric_background": "0x000000",
        "clear_before_numeric": true,
        "wait_for_vsync": true,
        "output_mode": "landscape",
        "rotation_degrees": 90,
        "image_target_width": 1080,
        "image_target_height": 1080,
        "show_camera_frame_stats": true,
        "camera_device_id": "camera-1",
        "frame_stats_scale": 3,
        "frame_stats_margin_x": 24,
        "frame_stats_margin_y": 24,
        "frame_stats_foreground": "0x00ff00",
        "frame_stats_background": "0x000000"
      }
    }
  ],
  "device_control_sources": []
}
